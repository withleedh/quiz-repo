{
  "name": "language-learning-automation",
  "version": "1.0.0",
  "description": "다채널 언어 학습 영상 자동화 시스템",
  "private": true,
  "scripts": {
    "dev": "remotion studio core/src/index.ts",
    "build": "remotion bundle",
    "test": "vitest",
    "test:run": "vitest run",
    "render": "npx ts-node core/scripts/render-video.ts",
    "generate:script": "npx ts-node core/scripts/generate-script.ts",
    "generate:tts": "npx ts-node core/scripts/generate-tts.ts",
    "pipeline": "npx ts-node core/scripts/pipeline.ts",
    "pipeline:all": "npx ts-node core/scripts/pipeline-all.ts",
    "list:channels": "npx ts-node -e \"import { listChannels } from './core/scripts/config-loader'; console.log(listChannels());\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/zod-types": "^4.0.0",
    "dotenv": "^16.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^27.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  }
}
